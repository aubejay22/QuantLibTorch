  "prototype_path": "build/phase8_pcr_layout_probe.py",
  "prototype_source_utf8": "\"\"\"Reversible PCR layout experiment; not part of the pricing implementation.\"\"\"\nimport argparse\nimport json\nimport statistics\nfrom pathlib import Path\nimport sys\nimport time\n\nimport torch\nfrom quantlibtorch import tridiagonal_solve_pcr\n\n\ndef packed_pcr(lower, diagonal, upper, rhs):\n    n = diagonal.shape[-1]\n    shape = torch.broadcast_shapes(lower.shape[:-1], diagonal.shape[:-1], upper.shape[:-1], rhs.shape[:-2])\n    lo = torch.cat((torch.zeros_like(lower[..., :1]), lower), -1).expand(*shape, n)\n    di = diagonal.expand(*shape, n)\n    up = torch.cat((upper, torch.zeros_like(upper[..., :1])), -1).expand(*shape, n)\n    state = torch.cat((torch.stack((lo, di, up), -1), rhs.expand(*shape, n, rhs.shape[-1])), -1)\n    step = 1\n    while step < n:\n        left, right = state.roll(step, -2), state.roll(-step, -2)\n        alpha, beta = -state[..., :1]/left[..., 1:2], -state[..., 2:3]/right[..., 1:2]\n        diagonal = state[..., 1:2]+alpha*left[..., 2:3]+beta*right[..., :1]\n        values = state[..., 3:]+alpha*left[..., 3:]+beta*right[..., 3:]\n        state = torch.cat((alpha*left[..., :1], diagonal, beta*right[..., 2:3], values), -1)\n        step *= 2\n    return state[..., 3:]/state[..., 1:2]\n\n\ndef run():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--layout', choices=('current', 'packed'), required=True)\n    parser.add_argument('--device', choices=('cpu', 'cuda'), default='cpu')\n    parser.add_argument('--shape', default='1x61x1')\n    parser.add_argument('--windows-qos', choices=('system', 'high'), default='high')\n    args = parser.parse_args()\n    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'scripts'))\n    from runtime_controls import worker_qos\n    qos = worker_qos(args.windows_qos)\n    torch.set_num_threads(1)\n    torch.set_num_interop_threads(1)\n    batch, n, nrhs = map(int, args.shape.split('x'))\n    gen = torch.Generator().manual_seed(277)\n    inputs = tuple(t.to(args.device).requires_grad_() for t in (\n        .1*torch.randn(batch, n-1, dtype=torch.float64, generator=gen),\n        2+torch.rand(batch, n, dtype=torch.float64, generator=gen),\n        -.1*torch.randn(batch, n-1, dtype=torch.float64, generator=gen),\n        torch.randn(batch, n, nrhs, dtype=torch.float64, generator=gen)))\n    weights = torch.linspace(-.7, 1.1, batch*n*nrhs, dtype=torch.float64, device=args.device).reshape(batch, n, nrhs)\n    solve = packed_pcr if args.layout == 'packed' else lambda *a: tridiagonal_solve_pcr(*a, check_pivots=False)\n    lo, di, up, rhs = inputs\n    reference = torch.linalg.solve(torch.diag_embed(lo, offset=-1)+torch.diag_embed(di)+torch.diag_embed(up, offset=1), rhs)\n    expected = torch.autograd.grad(reference, inputs, weights)\n    actual = solve(*inputs)\n    gradients = torch.autograd.grad(actual, inputs, weights)\n    torch.testing.assert_close(actual, reference, rtol=2e-12, atol=2e-13)\n    for value, target in zip(gradients, expected):\n        torch.testing.assert_close(value, target, rtol=2e-11, atol=2e-12)\n    def sync():\n        if args.device == 'cuda': torch.cuda.synchronize()\n    def measure():\n        sync()\n        start = time.perf_counter()\n        value = solve(*inputs)\n        sync()\n        forward = time.perf_counter()\n        gradient = torch.autograd.grad(value, inputs, weights)\n        sync()\n        backward = time.perf_counter()\n        del value, gradient\n        sync()\n        return {'forward': forward-start, 'backward': backward-forward, 'total': time.perf_counter()-start}\n    warmup = [measure() for _ in range(8)]\n    samples = [measure() for _ in range(9)]\n    print(json.dumps(dict(case=vars(args), worker_qos=qos, warmup=warmup, samples=samples,\n                         median={key: statistics.median(s[key] for s in samples) for key in samples[0]})))\n\n\nif __name__ == '__main__': run()\n",
