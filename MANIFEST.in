include CMakeLists.txt
include _build_support.py
include README.md
include LICENSE
include PROJECT_CONTEXT.md
include AGENTS.md
recursive-include cmake *.cmake
recursive-include cpp *.cpp *.hpp *.inc
recursive-include scripts *.py
recursive-include LICENSES *.txt
include docs/*.md
recursive-include examples *.py *.ipynb
recursive-include tests *.py
prune third_party
prune build
prune python/quantlibtorch/_native
global-exclude __pycache__ *.py[cod]
